{
	"name": "elysia-reference",
	"version": "0.1.0",
	"private": true,
	"description": "Elysia Reference \u2014 a clearer, structured reference for ElysiaJS. Unofficial, independent, community-maintained.",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@10.34.6",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"typecheck": "astro check && tsc --noEmit",
		"test": "node --test \"tests/**/*.test.ts\"",
		"docs:import": "node scripts/docs/import.ts",
		"docs:sync": "node scripts/docs/sync.ts",
		"docs:check": "node scripts/docs/check.ts",
		"verify": "pnpm typecheck && pnpm test && pnpm docs:check && pnpm build && pnpm docs:check --dist",
		"examples:smoke": "node scripts/examples/smoke.ts"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.4.3",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/starlight": "^0.42.6",
		"astro": "^7.3.8"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@mdx-js/mdx": "^3.1.1",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.10.0",
		"@types/unist": "^3.0.3",
		"github-slugger": "^2.0.0",
		"image-size": "^2.0.4",
		"mdast-util-directive": "^3.1.1",
		"mdast-util-gfm": "^3.1.0",
		"mdast-util-mdx": "^3.0.0",
		"mdast-util-to-markdown": "^2.1.2",
		"parse-entities": "^4.0.2",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"typescript": "~6.0.3",
		"unified": "^11.0.5",
		"yaml": "^2.9.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp"
		]
	}
}
