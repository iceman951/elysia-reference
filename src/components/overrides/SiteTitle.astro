---
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<div class="site-title-group">
	<Default />
	<a
		class="unofficial-badge"
		href="/project/about/"
		title="Independent community documentation. Not affiliated with or endorsed by the ElysiaJS maintainers."
		>Unofficial</a
	>
</div>

<style>
	.site-title-group {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
	}
	.unofficial-badge {
		flex-shrink: 0;
		padding: 0.125rem 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-2xs);
		font-weight: 600;
		letter-spacing: 0.04em;
		line-height: 1.5;
		text-decoration: none;
		text-transform: uppercase;
	}
	.unofficial-badge:hover,
	.unofficial-badge:focus-visible {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	@media (max-width: 34rem) {
		.unofficial-badge {
			display: none;
		}
	}
</style>
