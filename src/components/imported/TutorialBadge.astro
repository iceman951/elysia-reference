---
/** Link to the matching lesson of the official interactive tutorial. */
import { Icon } from '@astrojs/starlight/components';

interface Props {
	href: string;
}

const { href } = Astro.props;
---

<a class="tutorial-badge not-content" href={href}>
	<Icon name="rocket" size="0.95em" />
	Interactive tutorial
	<span class="sr-only"> (official site)</span>
</a>

<style>
	.tutorial-badge {
		display: inline-flex;
		gap: 0.375rem;
		align-items: center;
		padding: 0.125rem 0.625rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
		font-weight: 500;
		text-decoration: none;
	}
	.tutorial-badge:hover,
	.tutorial-badge:focus-visible {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
</style>
