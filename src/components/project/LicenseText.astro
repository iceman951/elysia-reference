---
/** The upstream license, rendered verbatim from third-party/elysia-documentation/LICENSE. */
import license from '../../../third-party/elysia-documentation/LICENSE?raw';
---

<pre class="license-text" aria-label="MIT License of the ElysiaJS documentation">{license.trim()}</pre>

<style>
	.license-text {
		padding: 1rem 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background-color: var(--sl-color-gray-6);
		color: var(--sl-color-gray-1);
		font-size: var(--sl-text-sm);
		line-height: 1.6;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
</style>
