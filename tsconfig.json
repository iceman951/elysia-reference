{
	"extends": "astro/tsconfigs/strictest",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", ".cache", "node_modules", "public"],
	"compilerOptions": {
		// Scripts under scripts/ and tests/ run directly on Node.js type stripping,
		// so only erasable TypeScript syntax is allowed (no enums, namespaces, …).
		"erasableSyntaxOnly": true,
		"paths": {
			"@components/*": ["./src/components/*"],
			"@config/*": ["./src/config/*"],
			"@generated/*": ["./src/generated/*"]
		}
	}
}
